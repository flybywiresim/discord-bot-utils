{
  "name": "fbw-discord-bot",
  "version": "1.0.0",
  "description": "Moderation, utility and support bot for the FlyByWire Simulations Discord server",
  "main": "./build/index.js",
  "exports": "./build/index.js",
  "scripts": {
    "start": "node .",
    "dev": "nodemon --config nodemon.json src/index.ts",
    "build": "tsc",
    "build:digitalocean": "pnpm install --frozen-lockfile && pnpm run build",
    "lint": "eslint \"src/**/**/*.ts\"",
    "lint-fix": "eslint \"src/**/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "author": "FlyByWire Simulations",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@11.5.3",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/lib-storage": "^3.1085.0",
    "@hokify/agenda": "^6.0.0",
    "@octokit/request": "^10.0.11",
    "cache-manager": "^7.2.9",
    "config": "^3.3.12",
    "discord.js": "^14.26.5",
    "jsdom": "^29.1.1",
    "keyv": "^5.6.0",
    "moment": "^2.29.4",
    "mongoose": "^9.9.4",
    "obscenity": "^0.4.6",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/config": "^3.3.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "ts-node": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "engines": {
    "node": "24.x"
  }
}
